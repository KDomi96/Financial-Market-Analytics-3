# Local credentials; tracked templates contain no secret values.
.env
.env.*
!.env.example
*.pem
*.key

# Supplied assignment material and local assistant files; never commit.
docs/assignment_brief.docx
docs/*.docx
CLAUDE.md
AGENTS.md
.claude/

# Local progress checklist derived from the assignment brief; never commit.
docs/phase_completion.md

# IBKR market data may not be redistributed under the subscriber agreement.
# Nothing from IBKR is committed: not the snapshots, not their manifests.
data/raw/ibkr/

# Keep sentiment source text local; record provenance and download commands.
data/raw/sentiment/
# Prepared benchmark rows and headline tables carry the same third-party text.
data/interim/sentiment/
# FinBERT files: third-party weights over GitHub's 100 MB file limit.
artifacts/sentiment/*/finbert/

# Python environments, bytecode, test/lint caches, and build products.
.venv/
.tools/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Notebook checkpoints and frontend dependencies/build output.
.ipynb_checkpoints/
node_modules/
.next/

# Editor and operating-system files.
.idea/
.vscode/
.DS_Store
Thumbs.db
~$*

# Data, models, and results are deliberately not blanket-ignored.
# Establish storage/versioning policy once providers and file sizes are known.

# First evaluated Phase 5 run, superseded by phase5_v2 and kept locally only.
**/phase5_v1/
outputs/metrics/phase5_v1_*_validation.json
